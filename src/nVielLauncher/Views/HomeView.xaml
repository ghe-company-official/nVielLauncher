<UserControl x:Class="nVielLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Главная" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Fabric 1.21.4 · профиль Steve" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0BFFFFFF"
                    BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="PillText" Text="ГОТОВ К ЗАПУСКУ" FontSize="9.5" FontWeight="SemiBold"
                               Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="298" />
            </Grid.ColumnDefinitions>

            <!-- hero -->
            <Border Style="{StaticResource Card}" Padding="26,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Width="150" Height="150"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Click="Play_Click" ToolTip="Играть">
                            <Grid Width="150" Height="150">
                                <Ellipse Fill="#FF0A0A0E" Stroke="#FF1E1E24" StrokeThickness="1" />
                                <Ellipse x:Name="DashRing" Margin="11" Stroke="#33FFFFFF" StrokeThickness="1"
                                         StrokeDashArray="2 6" />
                                <Ellipse x:Name="BusyRing" Margin="6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                                         StrokeDashArray="70 260" StrokeDashCap="Round" Visibility="Collapsed" />
                                <Path x:Name="PlayIcon" Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentBrush}"
                                      Width="42" Height="42" Stretch="Uniform" Margin="9,0,0,0" />
                                <TextBlock x:Name="PlayPercent" Text="0%" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="30,4,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MINECRAFT" Style="{StaticResource Overline}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Fabric" FontFamily="{StaticResource DisplayFont}" FontSize="36"
                                           FontWeight="SemiBold" />
                                <TextBlock Text=" 1.21.4" FontFamily="{StaticResource DisplayFont}" FontSize="36"
                                           FontWeight="Light" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="NickLine" Text="Игрок: Steve" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Border Style="{StaticResource InsetCard}" Padding="11,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRam}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              VerticalAlignment="Center" />
                                        <TextBlock x:Name="ChipRam" Text="4096 МБ" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Padding="11,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconMods}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ChipMods" Text="0 модов" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Padding="11,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconJava}" Width="12" Height="12" Stretch="Uniform"
                                              Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ChipJava" Text="Java —" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <Grid>
                            <TextBlock x:Name="StatusText" Text="Готов к запуску" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" FontSize="13.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>

                        <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}" Value="0" Margin="0,10,0,0" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="DetailText" Text="Файлы проверятся автоматически при запуске"
                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button x:Name="StopButton" Content="Остановить игру" Style="{StaticResource SmallGhostButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                                    Click="Stop_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- right column -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="23" Background="#FF101015"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <TextBlock x:Name="AvatarLetter" Text="S" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NicknameText" Text="Steve" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Оффлайн-профиль" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Сменить"
                                VerticalAlignment="Center" Click="ChangeNick_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,8" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="7" Background="#0FFFFFFF"
                                    BorderBrush="#16FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSparkles}" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Версия" FontSize="12" Margin="9,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Fabric 1.21.4" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
                        <Grid Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="7" Background="#0FFFFFFF"
                                    BorderBrush="#16FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMods}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Моды" FontSize="12" Margin="9,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="StatMods" Text="0" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
                        <Grid Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="7" Background="#0FFFFFFF"
                                    BorderBrush="#16FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRam}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Память" FontSize="12" Margin="9,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="StatRam" Text="4096 МБ" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
                        <Grid Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="7" Background="#0FFFFFFF"
                                    BorderBrush="#16FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconJava}" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Java" FontSize="12" Margin="9,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="StatJava" Text="проверка..." FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
                        <Grid Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="7" Background="#0FFFFFFF"
                                    BorderBrush="#16FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClock}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Запуск" FontSize="12" Margin="9,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="StatLastLaunch" Text="—" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Style="{StaticResource ActionTile}" Margin="0,0,5,5" Click="OpenGameFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#10FFFFFF"
                                    BorderBrush="#1CFFFFFF" BorderThickness="1">
                                <Path Data="{StaticResource IconFolder}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Папка игры" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="Открыть" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource ActionTile}" Margin="5,0,0,5" Click="OpenModsFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#10FFFFFF"
                                    BorderBrush="#1CFFFFFF" BorderThickness="1">
                                <Path Data="{StaticResource IconMods}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Моды" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="Папка mods" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Style="{StaticResource ActionTile}" Margin="0,5,5,0" Click="OpenLogsFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#10FFFFFF"
                                    BorderBrush="#1CFFFFFF" BorderThickness="1">
                                <Path Data="{StaticResource IconLogs}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Журнал" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="Логи" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionTile}" Margin="5,5,0,0" Click="ChangeNick_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#10FFFFFF"
                                    BorderBrush="#1CFFFFFF" BorderThickness="1">
                                <Path Data="{StaticResource IconUser}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Профиль" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="Сменить ник" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ============ log ============ -->
        <Border x:Name="LogCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Height="166">
            <Grid Margin="16,12,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="ЖУРНАЛ ЛАУНЧЕРА" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource LinkButton}" Content="Диагностика" Click="Diagnose_Click" />
                        <Button Style="{StaticResource LinkButton}" Content="Копировать" Margin="14,0,0,0" Click="CopyLog_Click" />
                        <Button Style="{StaticResource LinkButton}" Content="Очистить" Margin="14,0,0,0" Click="ClearLog_Click" />
                    </StackPanel>
                </Grid>

                <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                         FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" IsReadOnlyCaretVisible="False" Padding="0,2,2,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
