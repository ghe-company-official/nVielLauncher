<UserControl x:Class="nVielLauncher.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Резервные копии" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Миры и конфиги активного инстанса"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="OpenFolder_Click" ToolTip="Открыть папку резервных копий">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeLineJoin="Round" />
                        <TextBlock Text="Папка" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Click="Create_Click" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Создать копию" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource IconTile}" Width="38" Height="38" CornerRadius="11" VerticalAlignment="Top">
                    <Path Data="{StaticResource IconDisk}" Width="17" Height="17" Stretch="Uniform"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="InstanceText" Text="Основная" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="LastBackupText" Text="Копий пока нет" FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="RetentionText" Text="Хранятся последние 5 копий · только saves, config, options.txt и servers.dat"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox x:Name="AutoBackupToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" Checked="AutoBackup_Changed" Unchecked="AutoBackup_Changed">
                    <StackPanel>
                        <TextBlock Text="Перед запуском" FontSize="12.5" />
                        <TextBlock Text="не чаще раза в 12 часов" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </CheckBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="2,14,2,8">
            <ProgressBar x:Name="BackupProgress" Style="{StaticResource SlimProgress}" Minimum="0" Maximum="100"
                         Visibility="Collapsed" Margin="0,0,0,8" />
            <Grid>
                <TextBlock Text="СОХРАНЁННЫЕ КОПИИ" Style="{StaticResource Overline}" />
                <TextBlock x:Name="StatusText" Text="" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl x:Name="BackupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="15,13" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource IconTile}" Width="36" Height="36" CornerRadius="10"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDisk}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Meta}" FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding FileName}" FontSize="9.5"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallGhostButton}" Content="Восстановить"
                                                Tag="{Binding}" Click="Restore_Click" />
                                        <Button Style="{StaticResource SmallGhostButton}" Content="Удалить"
                                                Tag="{Binding}" Click="Delete_Click" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="28,30" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="16" Background="#10FFFFFF"
                                BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconDisk}" Width="24" Height="24" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Резервных копий пока нет" FontSize="16" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="Создай копию вручную или включи автосохранение перед запуском."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource InsetCard}" Padding="14,10" Margin="0,12,0,0">
            <TextBlock Text="Восстановление перезаписывает файлы миров и конфигов. Перед ним лаунчер автоматически сделает страховочную копию."
                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="ConfirmLayer" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed"
              Background="#CC050507" Panel.ZIndex="60">
            <Border Style="{StaticResource Card}" Width="420" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" Text="Восстановить копию?" FontSize="19" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock x:Name="ConfirmText" Text="" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    <TextBlock x:Name="ConfirmWarning" Text="" FontSize="10.5" Foreground="#FFFF9A9A"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="CloseConfirm_Click" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Продолжить"
                                Click="Confirm_Click" Margin="9,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
