<Window x:Class="nVielLauncher.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление nViel Launcher"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource TextFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="18" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Margin="18"
            Background="{StaticResource BgBrush}"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Grid.ColumnSpan="2" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="12">
                        <Path Data="{StaticResource IconRefresh}" Width="17" Height="17" Stretch="Uniform"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Обновление" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="VersionText" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource SmallGhostButton}"
                        AutomationProperties.AutomationId="UpdateCloseButton"
                        Content="✕" Padding="9,3" FontSize="12" ToolTip="Закрыть"
                        VerticalAlignment="Top" Click="Close_Click" />
            </Grid>

            <TextBlock Grid.Row="1" Text="Хотите установить обновление?"
                       FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                       Margin="0,22,0,0" />

            <TextBlock Grid.Row="2"
                       Text="Файл будет скачан, проверен по цифровой подписи и лаунчер перезапустится."
                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" />

            <Border Grid.Row="3" x:Name="NotesPanel" Background="#0AFFFFFF" BorderBrush="#18FFFFFF"
                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,16,0,0"
                    MaxHeight="132">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" FontSize="11" LineHeight="17"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <ProgressBar Grid.Row="4" x:Name="UpdateProgress" Style="{StaticResource SlimProgress}"
                         Value="0" Margin="0,18,0,0" Visibility="Collapsed" />

            <TextBlock Grid.Row="5" x:Name="StatusText" FontSize="10.5"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,9,0,0" Visibility="Collapsed" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="LaterButton" Style="{StaticResource SmallGhostButton}"
                        AutomationProperties.AutomationId="UpdateLaterButton"
                        Content="Позже" Padding="18,9" Click="Later_Click" />
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="UpdateInstallButton"
                        Content="Установить" Padding="20,10" FontSize="13" Margin="8,0,0,0"
                        IsDefault="True" Click="Install_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
