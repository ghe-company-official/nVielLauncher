<UserControl x:Class="nVielLauncher.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <UserControl.Resources>
        <Storyboard x:Key="ServersAmbient">
            <DoubleAnimation Storyboard.TargetName="ServersOrbitA" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:52" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ServersOrbitB" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:36" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ServersCoreScale" Storyboard.TargetProperty="ScaleX"
                             From="0.93" To="1.06" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ServersCoreScale" Storyboard.TargetProperty="ScaleY"
                             From="0.93" To="1.06" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ServersGlow" Storyboard.TargetProperty="Opacity"
                             From="0.08" To="0.2" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Сервера" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Сохрани любимые сервера и заходи в один клик"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlayFaintBrush}"
                    BorderBrush="{DynamicResource OverlayBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconGlobe}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountBadge" Text="0" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- add server -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconPlus}" Width="13" Height="13" Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock Text=" НОВЫЙ СЕРВЕР" Style="{StaticResource Overline}" />
                </StackPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Tag="Название" MaxLength="24" />
                    <TextBox Grid.Column="1" x:Name="HostBox" Style="{StaticResource InputBox}"
                             Tag="Адрес (play.example.com)" Margin="8,0,0,0" />
                    <TextBox Grid.Column="2" x:Name="PortBox" Style="{StaticResource InputBox}" Tag="25565" Width="92"
                             Margin="8,0,0,0" MaxLength="5" />
                    <Button Grid.Column="3" Style="{StaticResource SmallGhostButton}"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Add_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconPlus}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Добавить" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="AddStatus" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="2,10,0,0" Text="Адрес можно вставлять как «host» или «host:port»" />
            </StackPanel>
        </Border>

        <!-- list -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,14,10,6">
            <Grid>
                <Border x:Name="ServersHeroCard" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,18,0"
                        Width="166" Height="150" IsHitTestVisible="False">
                    <Grid>
                        <Ellipse Width="100" Height="100" Fill="{DynamicResource AccentBrush}" Opacity="0.11">
                            <Ellipse.Effect><BlurEffect Radius="24" /></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="138" Height="138" Stroke="{DynamicResource BorderSubtleBrush}"
                                 StrokeThickness="1" StrokeDashArray="1 5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="ServersOrbitA" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="104" Height="104" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                 StrokeDashArray="14 12" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="ServersOrbitB" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="ServersGlow" Width="74" Height="74" Fill="{DynamicResource AccentBrush}"
                                 Opacity="0.14" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Effect><BlurEffect Radius="16" /></Ellipse.Effect>
                            <Ellipse.RenderTransform><ScaleTransform x:Name="ServersCoreScale" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource BgSoftBrush}"
                                BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1">
                            <Path Data="{DynamicResource IconGlobe}" Width="26" Height="26" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Grid x:Name="ServerListContent">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ServersList" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceHoverBrush}"
                                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                                            <Path Data="{DynamicResource IconGlobe}" Width="15" Height="15" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Address}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallGhostButton}" Click="Play_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{DynamicResource IconPlay}" Width="12" Height="12" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <TextBlock Text="Играть" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SmallGhostButton}" Margin="8,0,0,0" Click="Delete_Click"
                                                    ToolTip="Удалить сервер из списка">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{DynamicResource IconTrash}" Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                                                    <TextBlock Text="Удалить" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource BgSoftBrush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{DynamicResource IconGlobe}" Width="22" Height="22" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Серверов пока нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Добавь адрес сверху — и сможешь заходить на сервер прямо из лаунчера."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" MaxWidth="400"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="4,12,0,0"
                   Text="Быстрый вход передаёт игре параметр --quickPlayMultiplayer." />
    </Grid>
</UserControl>
