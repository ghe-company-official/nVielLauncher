<UserControl x:Class="nVielLauncher.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Сервера" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Сохрани любимые сервера и заходи в один клик"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0BFFFFFF"
                    BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconGlobe}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountBadge" Text="0" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- add server -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="НОВЫЙ СЕРВЕР" Style="{StaticResource Overline}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Tag="Название" MaxLength="24" />
                    <TextBox Grid.Column="1" x:Name="HostBox" Style="{StaticResource InputBox}"
                             Tag="Адрес (play.example.com)" Margin="8,0,0,0" />
                    <TextBox Grid.Column="2" x:Name="PortBox" Style="{StaticResource InputBox}" Tag="25565" Width="92"
                             Margin="8,0,0,0" MaxLength="5" />
                    <Button Grid.Column="3" Style="{StaticResource SmallGhostButton}" Content="Добавить"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Add_Click" />
                </Grid>
                <TextBlock x:Name="AddStatus" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Margin="2,10,0,0" Text="Адрес можно вставлять как «host» или «host:port»" />
            </StackPanel>
        </Border>

        <!-- list -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,14,10,6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ServersList" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="10" Background="#FF101016"
                                                BorderBrush="#FF1E1E26" BorderThickness="1">
                                            <Path Data="{StaticResource IconGlobe}" Width="15" Height="15" Stretch="Uniform"
                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Address}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallGhostButton}" Content="Играть"
                                                    Click="Play_Click" />
                                            <Button Style="{StaticResource SmallGhostButton}" Content="Удалить"
                                                    Margin="8,0,0,0" Click="Delete_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16" Background="#FF0B0B0F"
                            BorderBrush="#FF232330" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconGlobe}" Width="22" Height="22" Stretch="Uniform"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Серверов пока нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Добавь адрес сверху — и сможешь заходить на сервер прямо из лаунчера."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" MaxWidth="400"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="4,12,0,0"
                   Text="Быстрый вход передаёт игре параметр --quickPlayMultiplayer." />
    </Grid>
</UserControl>
