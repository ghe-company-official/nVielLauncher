<UserControl x:Class="nVielLauncher.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Запуск" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Проверка файлов, модов и запуск Minecraft"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0BFFFFFF"
                    BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#FF8AE0A0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PillText" Text="ГОТОВ" FontSize="9.5" FontWeight="SemiBold"
                               Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- stage timeline -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <TextBlock Text="ЭТАПЫ ЗАПУСКА" Style="{StaticResource Overline}" />
                    <TextBlock x:Name="InstanceText" Text="" HorizontalAlignment="Right" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
                <StackPanel x:Name="StageList" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="StateIconTile" Style="{StaticResource IconTile}" Width="42" Height="42"
                                    CornerRadius="12" VerticalAlignment="Top">
                                <Path x:Name="StateIcon" Data="{StaticResource IconPlay}" Width="18" Height="18"
                                      Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StateTitle" Text="Готов к запуску" FontSize="18" FontWeight="SemiBold"
                                           FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap" />
                                <TextBlock x:Name="StateDetail" Text="Нажми «Играть» на главной или «Повторить» ниже."
                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" x:Name="PercentText" Text="0%" FontSize="22" FontWeight="SemiBold"
                                       FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar x:Name="LaunchProgressBar" Style="{StaticResource SlimProgress}" Minimum="0" Maximum="100"
                                     Value="0" Margin="0,18,0,0" />

                        <TextBlock x:Name="InstancePath" Text="" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="Отменить запуск"
                                    Click="Cancel_Click" Visibility="Collapsed" />
                            <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" Content="Повторить"
                                    Click="Retry_Click" Visibility="Collapsed" />
                            <Button x:Name="MinimizeButton" Style="{StaticResource GhostButton}" Content="Свернуть лаунчер"
                                    Click="Minimize_Click" Visibility="Collapsed" />
                            <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Content="Остановить игру"
                                    Click="Stop_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                            <Button x:Name="DiagnosticsButton" Style="{StaticResource GhostButton}" Content="Диагностика"
                                    Click="Diagnostics_Click" Visibility="Collapsed" />
                            <Button x:Name="HomeButton" Style="{StaticResource GhostButton}" Content="На главную"
                                    Click="Home_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetCard}" Padding="14,11" Margin="0,12,0,0">
                    <TextBlock x:Name="HintText"
                               Text="Лаунчер использует общие файлы игры для всех инстансов — переключение не запускает повторную загрузку."
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- log -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTerminal}" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" VerticalAlignment="Center" />
                            <TextBlock Text="Лог запуска" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource LinkButton}" Content="Очистить" Click="ClearLog_Click" FontSize="9.5" />
                            <Button Style="{StaticResource LinkButton}" Content="Копировать" Click="CopyLog_Click"
                                    FontSize="9.5" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#080809" BorderBrush="#16FFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="10,8">
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                 FontFamily="Consolas" FontSize="10.5" />
                    </Border>

                    <Button Grid.Row="2" x:Name="BackupsButton" Style="{StaticResource GhostButton}" Content="Открыть резервные копии"
                            Click="Backups_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
