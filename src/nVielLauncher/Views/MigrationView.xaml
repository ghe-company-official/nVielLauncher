<UserControl x:Class="nVielLauncher.Views.MigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <UserControl.Resources>
        <Style x:Key="MigrationCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#FF14141A" BorderBrush="{StaticResource StrokeStrongBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M3 8.2 6.4 11.5 13 4.8" Width="10" Height="10"
                                      Stretch="Uniform" Stroke="#FF08080A" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF4A4A55" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Перенос данных" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Скопируй миры, моды и настройки из старых лаунчеров — оригиналы останутся на месте"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#0BFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Width="12" Height="12" Stretch="Uniform"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountBadge" Text="0" FontSize="10.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Button x:Name="BackButton" Style="{StaticResource SmallGhostButton}" Content="Назад"
                        Margin="8,0,0,0" Padding="14,8" Click="Back_Click" />
            </StackPanel>
        </Grid>

        <!-- launcher list -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,14,10,6" Margin="0,0,0,12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <ItemsControl x:Name="LauncherList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource MigrationCheck}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Top" Margin="0,2,12,0"
                                                  AutomationProperties.Name="{Binding Name}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           FontWeight="SemiBold" />
                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF"
                                                        BorderThickness="1" CornerRadius="5" Padding="6,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Note}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Note}" FontSize="9"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DataSummary}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PathText}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   MaxWidth="190" TextAlignment="Right" TextWrapping="Wrap"
                                                   Margin="12,2,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock x:Name="EmptyTitle" Text="Ищу старые лаунчеры..." FontSize="14"
                               FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="EmptySubtitle" Text="Проверяю известные лаунчеры и их папки."
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Button x:Name="RetryButton" Style="{StaticResource SmallGhostButton}" Content="Проверить снова"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Padding="16,8"
                            Visibility="Collapsed" Click="Retry_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- import categories -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ЧТО ПЕРЕНОСИТЬ" Style="{StaticResource Overline}" />
                <WrapPanel Margin="0,10,0,0">
                    <CheckBox x:Name="WorldsCheck" Style="{StaticResource MigrationCheck}" Content="Миры"
                              IsChecked="True" Margin="0,6,18,0" />
                    <CheckBox x:Name="ModsCheck" Style="{StaticResource MigrationCheck}" Content="Моды"
                              IsChecked="True" Margin="0,6,18,0" />
                    <CheckBox x:Name="ResourcePacksCheck" Style="{StaticResource MigrationCheck}" Content="Ресурспаки"
                              IsChecked="True" Margin="0,6,18,0" />
                    <CheckBox x:Name="ShaderPacksCheck" Style="{StaticResource MigrationCheck}" Content="Шейдеры"
                              IsChecked="True" Margin="0,6,18,0" />
                    <CheckBox x:Name="ConfigsCheck" Style="{StaticResource MigrationCheck}" Content="Настройки"
                              IsChecked="True" Margin="0,6,0,0" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- progress and status -->
        <StackPanel Grid.Row="3">
            <ProgressBar x:Name="WorkProgress" Style="{StaticResource SlimProgress}"
                         IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- actions -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="RemoveButton" Style="{StaticResource SmallGhostButton}"
                    Content="Удалить старые..." Padding="14,9" Foreground="#FFE09A9A"
                    HorizontalAlignment="Left" Visibility="Collapsed"
                    Click="Remove_Click" ToolTip="Открыть штатные деинсталляторы выбранных лаунчеров" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExportButton" Style="{StaticResource SmallGhostButton}"
                        Content="Экспорт данных" Padding="16,9" Click="Export_Click" />
                <Button x:Name="LaterButton" Style="{StaticResource SmallGhostButton}"
                        Content="Позже" Padding="18,9" Margin="8,0,0,0" Click="Later_Click" />
                <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}"
                        Content="Импортировать" Padding="20,10" FontSize="13" Margin="8,0,0,0"
                        IsDefault="True" Click="Import_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
