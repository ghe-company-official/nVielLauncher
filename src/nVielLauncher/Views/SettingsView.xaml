<UserControl x:Class="nVielLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:nVielLauncher.Controls"
             xmlns:behaviors="clr-namespace:nVielLauncher.Behaviors"
             FontFamily="{StaticResource TextFont}">

    <UserControl.Resources>
        <Storyboard x:Key="SettingsAmbient">
            <DoubleAnimation Storyboard.TargetName="HeroOrbitA" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:42" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="HeroOrbitB" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:28" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="HeroBreath" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.08" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="HeroBreath" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.08" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="HeroGlow" Storyboard.TargetProperty="Opacity"
                             From="0.10" To="0.24" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="HeroSparkA" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="HeroSparkB" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.8" Duration="0:0:2.4" BeginTime="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LiveDot" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Настройки" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Твоё пространство. Настрой лаунчер под себя."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToastText" Text="Сохранено" FontSize="11.5" Opacity="0"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Padding="20,10" Click="Save_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,6,0" PanningMode="VerticalOnly">
            <StackPanel x:Name="CardsPanel">

                <!-- ================= settings hero ================= -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
                    <Grid MinHeight="154">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="24,22,8,22" VerticalAlignment="Center">
                            <TextBlock Text="ТВОЙ ЛАУНЧЕР · ТВОИ ПРАВИЛА" Style="{StaticResource Overline}" />
                            <TextBlock Text="Настрой nViel под себя" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Профиль, внешний вид и производительность — всё в одном месте."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="1" Width="176" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="106" Height="106" Fill="{DynamicResource AccentBrush}" Opacity="0.12">
                                <Ellipse.Effect><BlurEffect Radius="28" /></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="132" Height="132" Stroke="{DynamicResource BorderSubtleBrush}"
                                     StrokeThickness="1" StrokeDashArray="1 5" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="HeroOrbitA" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="104" Height="104" Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="1.5" StrokeDashArray="18 14" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="HeroOrbitB" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="HeroGlow" Width="78" Height="78" Fill="{DynamicResource AccentBrush}"
                                     Opacity="0.16" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Effect><BlurEffect Radius="20" /></Ellipse.Effect>
                                <Ellipse.RenderTransform><ScaleTransform x:Name="HeroBreath" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Border Width="54" Height="54" CornerRadius="18" Background="{DynamicResource BgSoftBrush}"
                                    BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1">
                                <Path Data="{DynamicResource IconSparkles}" Width="23" Height="23" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse x:Name="HeroSparkA" Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,19,19,0" />
                            <Ellipse x:Name="HeroSparkB" Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,17" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================= profile ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="60" Height="60" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource OverlaySoftBrush}" Stroke="{DynamicResource OverlayStrongBrush}" StrokeThickness="1" />
                            <Ellipse Width="48" Height="48" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource StrokeStrongBrush}" StrokeThickness="1" />
                            <TextBlock x:Name="AvatarLetter" Text="S" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Профиль" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Ник, под которым ты заходишь в игру" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                            <TextBox x:Name="NickBox" Style="{StaticResource InputBox}" Tag="Steve" MaxLength="16"
                                     Width="260" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource InsetCard}" Padding="12,7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OfflineDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Оффлайн" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= live monitor ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10">
                                    <Path Data="{DynamicResource IconCpu}" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Система" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Живой монитор нагрузки" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlaySoftBrush}"
                                    BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="9,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LiveDot" Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- cpu -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconCpu}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="CPU" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <Grid x:Name="CpuTrack" Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border Background="{DynamicResource OverlayBrush}" CornerRadius="3" />
                                <Border x:Name="CpuFill" HorizontalAlignment="Left" Width="0" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#8CFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                                    </Border.Effect>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="CpuText" Grid.Column="2" Text="0%" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- ram -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconRam}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="RAM" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <Grid x:Name="RamTrack" Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border Background="{DynamicResource OverlayBrush}" CornerRadius="3" />
                                <Border x:Name="RamFill" HorizontalAlignment="Left" Width="0" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#8CFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                                    </Border.Effect>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="RamText" Grid.Column="2" Text="—" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="CoresText" Style="{StaticResource Caption}" Margin="0,16,0,0"
                                   Text="Определяем характеристики системы..." />
                    </StackPanel>
                </Border>

                <!-- ================= performance ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10">
                                    <Path Data="{DynamicResource IconBolt}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Производительность" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Сколько памяти выделять и как запускать игру" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource InsetCard}"
                                    Padding="11,6">
                                <TextBlock x:Name="RamValueText" Text="4096 МБ" FontSize="12.5" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Slider x:Name="RamSlider" Style="{StaticResource SlimSlider}" Minimum="2048" Maximum="16384"
                                TickFrequency="512" IsSnapToTickEnabled="True" Margin="0,22,0,0"
                                ValueChanged="RamSlider_ValueChanged" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="RamAllocTrack" Height="5" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border Background="{DynamicResource OverlayBrush}" CornerRadius="2.5" />
                                <Border x:Name="RamAllocFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#C4FFFFFF" Offset="0" />
                                            <GradientStop Color="#59FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="RamAllocText" Grid.Column="1" Text="—" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="RamHintText" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />

                        <Border Height="1" Background="{DynamicResource StrokeSoftBrush}" Margin="0,16,0,2" />

                        <CheckBox x:Name="FullscreenToggle" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                  Checked="Behavior_Changed" Unchecked="Behavior_Changed">
                            <StackPanel>
                                <TextBlock Text="Полноэкранный режим" FontSize="13" />
                                <TextBlock Text="Игра откроется на весь экран" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ShowResolutionToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Checked="Behavior_Changed" Unchecked="Behavior_Changed">
                            <StackPanel>
                                <TextBlock Text="Своё разрешение окна" FontSize="13" />
                                <TextBlock Text="Применить ширину и высоту при запуске" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <Border x:Name="ResolutionPanel" Style="{StaticResource InsetCard}" Padding="12,10" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ширина" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="ResolutionWidthBox" Style="{StaticResource InputBox}" Width="86"
                                         FontSize="12" Padding="10,7" MaxLength="4" Tag="1280"
                                         TextChanged="ResolutionBox_TextChanged" LostFocus="ResolutionBox_LostFocus" />
                                <TextBlock Text="×" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="10,0,10,0" />
                                <TextBlock Text="Высота" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="ResolutionHeightBox" Style="{StaticResource InputBox}" Width="86"
                                         FontSize="12" Padding="10,7" MaxLength="4" Tag="720"
                                         TextChanged="ResolutionBox_TextChanged" LostFocus="ResolutionBox_LostFocus" />
                                <TextBlock Text="px" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="CloseLauncherToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Checked="Behavior_Changed" Unchecked="Behavior_Changed">
                            <StackPanel>
                                <TextBlock Text="Закрывать лаунчер после запуска" FontSize="13" />
                                <TextBlock Text="Освободит память, пока игра работает" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ================= appearance ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10">
                                    <Path Data="{DynamicResource IconSparkles}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Внешний вид" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Акцент, свечение, анимации и обучение" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SmallGhostButton}" Content="Показать обучение"
                                    Click="ReplayTour_Click" />
                        </Grid>

                        <CheckBox x:Name="AnimationsToggle" Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0"
                                  Checked="Behavior_Changed" Unchecked="Behavior_Changed">
                            <StackPanel>
                                <TextBlock Text="Плавные анимации" FontSize="13" />
                                <TextBlock Text="Переходы между страницами и появление карточек" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="BlurToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Checked="Behavior_Changed" Unchecked="Behavior_Changed">
                            <StackPanel>
                                <TextBlock Text="Размытие фона" FontSize="13" />
                                <TextBlock Text="Затемнять и размывать лаунчер во время обучения" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="GlowToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Checked="Behavior_Changed" Unchecked="Behavior_Changed">
                            <StackPanel>
                                <TextBlock Text="Фоновое свечение" FontSize="13" />
                                <TextBlock Text="Плавные световые пятна за интерфейсом" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="SplashToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Checked="Behavior_Changed" Unchecked="Behavior_Changed">
                            <StackPanel>
                                <TextBlock Text="Экран загрузки при старте" FontSize="13" />
                                <TextBlock Text="Показывать логотип и прогресс при открытии лаунчера" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Акцентный оттенок" FontSize="13" />
                            <TextBlock Text="Цвет кнопки запуска, статусов и переключателей" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            <WrapPanel x:Name="AccentSwatches" Margin="0,12,0,0" />
                            <Button x:Name="CustomAccentButton" Style="{StaticResource LinkButton}" Content="Свой цвет…"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="CustomAccent_Click" />
                            <Border x:Name="CustomAccentPanel" Style="{StaticResource InsetCard}" Padding="16,14"
                                    Margin="0,10,0,0" Visibility="Collapsed"
                                    behaviors:CardTapAnimationBehavior.IsEnabled="False">
                                <controls:ColorWheelPicker x:Name="AccentPicker" />
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Тема оформления" FontSize="13" />
                            <TextBlock Text="Material You строит палитру из акцента и основного цвета" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            <WrapPanel x:Name="ThemeModePanel" Margin="0,10,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="BaseColorSection" Margin="0,18,0,0">
                            <TextBlock Text="Основной цвет" FontSize="13" />
                            <TextBlock Text="Задаёт оттенок фона, поверхностей и границ" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            <WrapPanel x:Name="BaseSwatches" Margin="0,12,0,0" />
                            <Button x:Name="CustomBaseButton" Style="{StaticResource LinkButton}" Content="Свой цвет…"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="CustomBase_Click" />
                            <Border x:Name="CustomBasePanel" Style="{StaticResource InsetCard}" Padding="16,14"
                                    Margin="0,10,0,0" Visibility="Collapsed"
                                    behaviors:CardTapAnimationBehavior.IsEnabled="False">
                                <controls:ColorWheelPicker x:Name="BasePicker" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= icons ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10">
                                    <Path Data="{DynamicResource IconSparkles}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Иконки" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Свой SVG-контур для любой иконки лаунчера" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SmallGhostButton}" Content="Сбросить все"
                                    Click="ResetAllIcons_Click" />
                        </Grid>

                        <WrapPanel x:Name="IconGrid" Margin="0,16,0,0" />

                        <Border x:Name="IconEditor" Style="{StaticResource InsetCard}" Padding="16,14"
                                Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Path x:Name="IconEditorPreview" Width="18" Height="18" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="IconEditorTitle" FontSize="13" FontWeight="SemiBold"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource SmallGhostButton}" Content="Сбросить"
                                            Click="ResetIcon_Click" />
                                </Grid>

                                <TextBox x:Name="IconPathBox" Style="{StaticResource InputBox}" Margin="0,12,0,0"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11.5" Height="76"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Применить" Padding="16,8"
                                            Click="ApplyIcon_Click" />
                                    <TextBlock x:Name="IconErrorText" Foreground="{DynamicResource DangerBrush}"
                                               FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ================= java ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top">
                            <Path Data="{DynamicResource IconJava}" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Java" Style="{StaticResource CardTitle}" />
                                <Ellipse x:Name="JavaStatusDot" Width="6" Height="6" Fill="{DynamicResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock x:Name="JavaStatusText" Text="проверка" FontSize="10.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="JavaPathText" Text="не найдена" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="JavaInfoText" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                       Text="Для Minecraft 1.21.4 нужна Java 21. Если её нет — скачаем автоматически." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallGhostButton}" Content="Найти" Click="FindJava_Click" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="Указать" Margin="8,0,0,0" Click="BrowseJava_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= game folder ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top">
                            <Path Data="{DynamicResource IconFolder}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                            <TextBlock Text="Папка активного инстанса" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="GameDirText" Text="—" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="GameDirCaptionText" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                       Text="Миры, моды и конфиги этого инстанса. Общие файлы игры хранятся отдельно." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenInstancesButton" Style="{StaticResource SmallGhostButton}" Content="Инстансы"
                                    Click="OpenInstances_Click" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="Изменить" Margin="8,0,0,0" Click="BrowseGameDir_Click" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="Открыть" Margin="8,0,0,0" Click="OpenGameDir_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= quick actions ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Быстрые действия" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Всё важное — в один клик" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Style="{StaticResource ActionTile}" Margin="0,0,6,6" Click="OpenGameDir_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                                        <Path Data="{DynamicResource IconFolder}" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Папка игры" FontSize="12.5" FontWeight="Medium" />
                                        <TextBlock Text="Открыть каталог" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource ActionTile}" Margin="6,0,0,6" Click="OpenModsFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                                        <Path Data="{DynamicResource IconMods}" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Моды" FontSize="12.5" FontWeight="Medium" />
                                        <TextBlock Text="Открыть папку mods" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Style="{StaticResource ActionTile}" Margin="0,6,0,0" Click="OpenLogs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                                        <Path Data="{DynamicResource IconLogs}" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Журналы" FontSize="12.5" FontWeight="Medium" />
                                        <TextBlock Text="Открыть логи лаунчера" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionTile}" Margin="6,6,0,0"
                                    Click="FindJava_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                                        <Path Data="{DynamicResource IconRefresh}" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Java" FontSize="12.5" FontWeight="Medium" />
                                        <TextBlock Text="Найти заново" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ActionTile}" Margin="0,6,0,0"
                                    Click="Diagnose_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                                        <Path Data="{DynamicResource IconTerminal}" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Диагностика" FontSize="12.5" FontWeight="Medium" />
                                        <TextBlock Text="Проверить файлы и показать отчёт" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= recovery mode ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top">
                            <Path Data="{DynamicResource IconShield}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Восстановление" Style="{StaticResource CardTitle}" />
                                <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="nVielRE" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Сервисный режим: проверит Java, файлы Minecraft, Fabric и моды, покажет журнал и вернёт в лаунчер."
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Открыть nVielRE"
                                Padding="18,10" FontSize="12.5" VerticalAlignment="Center" Click="OpenRe_Click" />
                    </Grid>
                </Border>

                <!-- ================= updates ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top">
                            <Path Data="{DynamicResource IconRefresh}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Обновления" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Лаунчер проверяет обновления при запуске и раз в 6 часов. Можно проверить вручную."
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <Button x:Name="CheckUpdatesButton" Grid.Column="2" Style="{StaticResource SmallGhostButton}"
                                Content="Проверить обновления" VerticalAlignment="Center" Click="CheckUpdates_Click" />
                    </Grid>
                </Border>

                <!-- ================= migration ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10"
                                VerticalAlignment="Top">
                            <Path Data="{DynamicResource IconFolder}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                            <TextBlock Text="Перенос из старых лаунчеров" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="TLauncher, Legacy Launcher, LExplosion (NightWorld), Modrinth App, официальный лаунчер, Prism, MultiMC и другие."
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="Можно скопировать миры, моды и настройки или сохранить всё в ZIP."
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource SmallGhostButton}" Content="Открыть"
                                Padding="16,9" VerticalAlignment="Center" Click="OpenMigration_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top">
                            <Path Data="{DynamicResource IconDisk}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                            <TextBlock Text="Резервные копии" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Миры, конфиги, options.txt и servers.dat активного инстанса. Копию можно создать вручную или автоматически перед запуском."
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="Хранятся последние копии — старые удаляются автоматически."
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>

                        <Button x:Name="OpenBackupsButton" Grid.Column="2" Style="{StaticResource SmallGhostButton}"
                                Content="Открыть" Padding="16,9" VerticalAlignment="Center" Click="OpenBackups_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="Данные и перенос настроек" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="StorageDetailText"
                                       Text="Настройки можно перенести на другой компьютер одним JSON-файлом."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallGhostButton}" Content="Экспорт"
                                    Margin="0,0,8,0" Click="ExportSettings_Click" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="Импорт"
                                    Margin="0,0,8,0" Click="ImportSettings_Click" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="Portable"
                                    Click="Portable_Click" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- ================= about (always last) ================= -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="66" Height="66" VerticalAlignment="Center">
                            <Ellipse x:Name="AboutRing" Stroke="{DynamicResource BorderSubtleBrush}" StrokeThickness="1" StrokeDashArray="2 5"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="AboutRingRotate" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="44" Height="44" Fill="{DynamicResource BgSoftBrush}" Stroke="{DynamicResource OverlayStrongBrush}" StrokeThickness="1" />
                            <TextBlock Text="nViel" FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="О лаунчере" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="AboutVersionText" Text="nViel Launcher 1.2.5 Global · Window Update, first chapter · Fabric 1.21.4" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="StorageModeText" Text="Локальные настройки"
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallGhostButton}" Content="Сбросить" Click="Reset_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,16" TextWrapping="Wrap"
                           Text="Файлы игры скачиваются с официальных серверов Mojang и FabricMC. Настройки хранятся локально." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
