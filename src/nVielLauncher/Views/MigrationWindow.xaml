<Window x:Class="nVielLauncher.Views.MigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перенос из старых лаунчеров"
        Width="760"
        Height="720"
        MinWidth="660"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource TextFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="18" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MigrationCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#FF14141A" BorderBrush="{StaticResource StrokeStrongBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M3 8.2 6.4 11.5 13 4.8" Width="10" Height="10"
                                      Stretch="Uniform" Stroke="#FF08080A" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF4A4A55" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="{StaticResource BgBrush}" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Grid.ColumnSpan="2" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="12">
                        <Path Data="{StaticResource IconFolder}" Width="17" Height="17" Stretch="Uniform"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Перенос данных" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="nViel Launcher" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource SmallGhostButton}"
                        AutomationProperties.Name="Закрыть" Content="✕" Padding="9,3" FontSize="12"
                        ToolTip="Закрыть" VerticalAlignment="Top" Click="Close_Click" />
            </Grid>

            <TextBlock Grid.Row="1" Text="Перенести данные и убрать старые лаунчеры?"
                       FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                       Margin="0,22,0,0" />

            <TextBlock Grid.Row="2"
                       Text="Нашли лаунчеры на этом компьютере. Можно скопировать миры, моды и настройки в nViel. Оригиналы останутся на месте, пока ты сам не подтвердишь удаление."
                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       LineHeight="18" Margin="0,8,0,0" />

            <!-- launcher list -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="286">
                    <ItemsControl x:Name="LauncherList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource MigrationCheck}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Top" Margin="0,2,12,0"
                                                  AutomationProperties.Name="{Binding Name}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           FontWeight="SemiBold" />
                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF"
                                                        BorderThickness="1" CornerRadius="5" Padding="6,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Note}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Note}" FontSize="9"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DataSummary}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PathText}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   MaxWidth="190" TextAlignment="Right" TextWrapping="Wrap"
                                                   Margin="12,2,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="Старые лаунчеры не найдены" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Если лаунчер появится позже, перенос можно открыть из настроек."
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <!-- import categories -->
            <WrapPanel Grid.Row="4" Margin="0,4,0,0">
                <CheckBox x:Name="WorldsCheck" Style="{StaticResource MigrationCheck}" Content="Миры"
                          IsChecked="True" Margin="0,6,18,0" />
                <CheckBox x:Name="ModsCheck" Style="{StaticResource MigrationCheck}" Content="Моды"
                          IsChecked="True" Margin="0,6,18,0" />
                <CheckBox x:Name="ResourcePacksCheck" Style="{StaticResource MigrationCheck}" Content="Ресурспаки"
                          IsChecked="True" Margin="0,6,18,0" />
                <CheckBox x:Name="ShaderPacksCheck" Style="{StaticResource MigrationCheck}" Content="Шейдеры"
                          IsChecked="True" Margin="0,6,18,0" />
                <CheckBox x:Name="ConfigsCheck" Style="{StaticResource MigrationCheck}" Content="Настройки"
                          IsChecked="True" Margin="0,6,0,0" />
            </WrapPanel>

            <ProgressBar Grid.Row="5" x:Name="WorkProgress" Style="{StaticResource SlimProgress}"
                         IsIndeterminate="True" Margin="0,16,0,0" Visibility="Collapsed" />

            <TextBlock Grid.Row="6" x:Name="StatusText" FontSize="10.5"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,9,0,0" Visibility="Collapsed" />

            <!-- actions -->
            <Grid Grid.Row="7" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RemoveButton" Style="{StaticResource SmallGhostButton}"
                        Content="Удалить старые..." Padding="14,9" Foreground="#FFE09A9A"
                        Click="Remove_Click" ToolTip="Открыть штатные деинсталляторы выбранных лаунчеров" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="ExportButton" Style="{StaticResource SmallGhostButton}"
                            Content="Экспорт данных" Padding="16,9" Click="Export_Click" />
                    <Button x:Name="LaterButton" Style="{StaticResource SmallGhostButton}"
                            Content="Позже" Padding="18,9" Margin="8,0,0,0" Click="Close_Click" />
                    <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}"
                            Content="Импортировать" Padding="20,10" FontSize="13" Margin="8,0,0,0"
                            IsDefault="True" Click="Import_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
