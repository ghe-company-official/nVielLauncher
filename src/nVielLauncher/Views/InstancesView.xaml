<UserControl x:Class="nVielLauncher.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <UserControl.Resources>
        <Storyboard x:Key="InstanceAmbient">
            <DoubleAnimation Storyboard.TargetName="InstanceOrbitA" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:48" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InstanceOrbitB" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:31" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InstanceCoreScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.06" Duration="0:0:3.4" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InstanceCoreScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.06" Duration="0:0:3.4" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InstanceGlow" Storyboard.TargetProperty="Opacity"
                             From="0.08" To="0.24" Duration="0:0:3.4" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InstanceSparkA" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="InstanceSparkB" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.9" Duration="0:0:2.2" BeginTime="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- header -->
        <Grid Grid.Row="0" Margin="2,6,2,16">
            <StackPanel>
                <TextBlock Text="Инстансы" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Разные сборки — разные миры, моды и настроение."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{DynamicResource OverlayFaintBrush}" BorderBrush="{DynamicResource OverlayBrush}" BorderThickness="1" CornerRadius="9"
                        Padding="12,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconInstance}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" />
                        <TextBlock x:Name="CountText" Text="1 инстанс" FontSize="11.5" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Click="Create_Click"
                        ToolTip="Создать новый инстанс">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconPlus}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Новый инстанс" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- lively overview -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
                    <Grid MinHeight="172">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="23,21,8,20" VerticalAlignment="Center">
                            <TextBlock Text="ТВОЯ ИГРОВАЯ ВСЕЛЕННАЯ" Style="{StaticResource Overline}" />
                            <TextBlock Text="Каждому миру — свой инстанс" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Экспериментируй со сборками, оставляя основной Minecraft в порядке."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Background="{DynamicResource OverlayFaintBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconMods}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                        <TextBlock Text=" МОДЫ" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource OverlayFaintBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconGlobe}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                        <TextBlock Text=" МИРЫ" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource OverlayFaintBrush}" CornerRadius="7" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconSliders}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                        <TextBlock Text=" СВОИ ПРАВИЛА" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="190" Height="162" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="116" Height="116" Fill="{DynamicResource AccentBrush}" Opacity="0.12">
                                <Ellipse.Effect><BlurEffect Radius="28" /></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="148" Height="148" Stroke="{DynamicResource BorderSubtleBrush}"
                                     StrokeThickness="1" StrokeDashArray="1 5" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="InstanceOrbitA" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="112" Height="112" Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="1.3" StrokeDashArray="16 13" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="InstanceOrbitB" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="InstanceGlow" Width="84" Height="84" Fill="{DynamicResource AccentBrush}"
                                     Opacity="0.15" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Effect><BlurEffect Radius="18" /></Ellipse.Effect>
                                <Ellipse.RenderTransform><ScaleTransform x:Name="InstanceCoreScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Border Width="56" Height="56" CornerRadius="18" Background="{DynamicResource BgSoftBrush}"
                                    BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1">
                                <Path Data="{DynamicResource IconInstance}" Width="26" Height="26" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse x:Name="InstanceSparkA" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,19,0" />
                            <Ellipse x:Name="InstanceSparkB" Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="27,0,0,19" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- active instance -->
                <Border x:Name="ActiveCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ActiveStatusDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="  СЕЙЧАС ВЫБРАН" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="ActiveName" Text="Основная" FontSize="22" FontWeight="SemiBold"
                                       FontFamily="{StaticResource DisplayFont}" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Path Data="{DynamicResource IconFolder}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" />
                                <TextBlock x:Name="ActivePath" Text="—" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ActiveStats" Text="—" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="300">
                            <Button Style="{StaticResource GhostButton}" Click="OpenActiveFolder_Click"
                                    ToolTip="Открыть папку активного инстанса">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                                    <TextBlock Text="Папка" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="7,0,0,0" Click="SettingsActive_Click"
                                    ToolTip="Память, ник, Java и окно только для этого инстанса">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconSliders}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                                    <TextBlock Text="Настройки" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="7,7,0,0" Click="CloneActive_Click"
                                    ToolTip="Точная копия этого инстанса: моды, миры и настройки">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconCopy}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                                    <TextBlock Text="Клонировать" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="7,7,0,0" Click="Rename_Click"
                                    ToolTip="Переименовать активный инстанс">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconSettings}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Переименовать" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteActiveButton" Style="{StaticResource GhostButton}" Margin="7,7,0,0"
                                    Click="DeleteActive_Click" ToolTip="Удалить активный инстанс вместе с файлами">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource IconTrash}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                                    <TextBlock Text="Удалить" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid Margin="2,18,2,10">
                    <TextBlock Text="Все инстансы" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="ListHint" Text="Нажми «Выбрать», чтобы переключиться"
                               HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>

                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Height="12" Width="180" CornerRadius="4" Background="{DynamicResource OverlaySoftBrush}" HorizontalAlignment="Left" />
                            <Border Height="9" Width="310" CornerRadius="4" Background="{DynamicResource OverlayFaintBrush}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Height="12" Width="150" CornerRadius="4" Background="{DynamicResource OverlaySoftBrush}" HorizontalAlignment="Left" />
                            <Border Height="9" Width="260" CornerRadius="4" Background="{DynamicResource OverlayFaintBrush}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="InstanceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Background="{Binding CardBackground}"
                                    BorderBrush="{Binding CardBorder}" Padding="15,13" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="46" Height="46" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.08" />
                                        <Border Style="{StaticResource IconTile}" Width="38" Height="38" CornerRadius="12"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{DynamicResource IconInstance}" Width="17" Height="17" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1"
                                                    CornerRadius="5" Padding="6,2" Margin="8,0,0,0"
                                                    Visibility="{Binding ActiveBadgeVisibility}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text=" АКТИВЕН" FontSize="8.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource OverlayFaintBrush}" BorderBrush="{DynamicResource OverlayBrush}" BorderThickness="1"
                                                    CornerRadius="5" Padding="6,2" Margin="6,0,0,0"
                                                    Visibility="{Binding DefaultBadgeVisibility}">
                                                <TextBlock Text="ОСНОВНОЙ" FontSize="8.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Path Data="{DynamicResource IconFolder}" Width="11" Height="11" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" />
                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="5,0,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Path Data="{DynamicResource IconMods}" Width="12" Height="12" Stretch="Uniform"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" />
                                            <TextBlock Text="{Binding Stats}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="270">
                                        <Button Style="{StaticResource SmallGhostButton}" Tag="{Binding Id}" Click="Activate_Click"
                                                Visibility="{Binding ActivateVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{DynamicResource IconCheck}" Width="12" Height="12" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <TextBlock Text="Выбрать" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SmallGhostButton}" Tag="{Binding Id}" Click="CloneRow_Click"
                                                ToolTip="Создать точную копию этого инстанса" Margin="7,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{DynamicResource IconCopy}" Width="12" Height="12" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                                                <TextBlock Text="Копия" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SmallGhostButton}" Tag="{Binding Id}" Click="DeleteRow_Click"
                                                Visibility="{Binding DeleteVisibility}" Margin="7,0,0,0" ToolTip="Удалить инстанс">
                                            <Path Data="{DynamicResource IconTrash}" Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4" StrokeLineJoin="Round" />
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="26,28" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{DynamicResource IconInstance}" Width="30" Height="30" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Пока только основной инстанс" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Создай отдельную сборку, чтобы не смешивать моды и миры."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- per-instance settings -->
        <Grid x:Name="SettingsLayer" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}" Panel.ZIndex="55">
            <Border Style="{StaticResource Card}" Width="470" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="SettingsTitle" Text="Настройки инстанса" FontSize="19"
                                           FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                <TextBlock Text="Пустые поля работают как в общих настройках."
                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="Сбросить" Click="ResetInstanceSettings_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    ToolTip="Убрать все индивидуальные настройки этого инстанса" />
                        </Grid>

                        <TextBlock Text="НИК В ОФФЛАЙНЕ" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,18,0,6" />
                        <TextBox x:Name="InstanceNickBox" Style="{StaticResource InputBox}" MaxLength="16" />
                        <TextBlock x:Name="NickHint" Text="" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />

                        <CheckBox x:Name="RamOverrideCheck" Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0"
                                  Checked="RamOverride_ValueChanged" Unchecked="RamOverride_ValueChanged">
                            <StackPanel>
                                <TextBlock Text="Свой объём памяти" FontSize="13" />
                                <TextBlock x:Name="RamHint" Text="" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Grid x:Name="RamPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock x:Name="RamValueText" Text="4096 МБ" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <Slider x:Name="InstanceRamSlider" Style="{StaticResource SlimSlider}" Minimum="2048" Maximum="16384"
                                TickFrequency="512" IsSnapToTickEnabled="True" Margin="0,12,0,0"
                                ValueChanged="InstanceRamSlider_ValueChanged" />

                        <TextBlock Text="ПУТЬ К JAVA.EXE (ПОЛНОСТЬЮ)" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,18,0,6" />
                        <TextBox x:Name="InstanceJavaBox" Style="{StaticResource InputBox}" />
                        <TextBlock Text="Например: C:\Program Files\Eclipse Adoptium\jdk-21\bin\javaw.exe. Пусто — общая Java."
                                   FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <CheckBox x:Name="ScreenOverrideCheck" Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0"
                                  Checked="ScreenOverride_ValueChanged" Unchecked="ScreenOverride_ValueChanged">
                            <StackPanel>
                                <TextBlock Text="Свои настройки окна игры" FontSize="13" />
                                <TextBlock Text="Снимите галочку, чтобы окно запускалось как в общих настройках."
                                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <StackPanel x:Name="ScreenPanel" Visibility="Collapsed">
                            <CheckBox x:Name="InstanceFullscreenCheck" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0">
                                <TextBlock Text="Полноэкранный режим" FontSize="13" />
                            </CheckBox>
                            <CheckBox x:Name="InstanceResolutionCheck" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      Checked="InstanceResolution_ValueChanged" Unchecked="InstanceResolution_ValueChanged">
                                <TextBlock Text="Задать размер окна" FontSize="13" />
                            </CheckBox>
                            <StackPanel x:Name="ResolutionPanel" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="InstanceWidthBox" Style="{StaticResource InputBox}" Width="92" />
                                <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="InstanceHeightBox" Style="{StaticResource InputBox}" Width="92" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="SettingsError" Text="" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="SettingsBusy" Text="" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,12,0,0" Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="CloseSettings_Click" />
                            <Button x:Name="SettingsConfirmButton" Style="{StaticResource PrimaryButton}" Content="Сохранить"
                                    Click="SettingsConfirm_Click" Margin="9,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- in-page editor -->
        <Grid x:Name="EditorLayer" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}" Panel.ZIndex="50">
            <Border Style="{StaticResource Card}" Width="430" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Text="Новый инстанс" FontSize="19" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock Text="Название видно только в лаунчере. Файлы останутся в отдельной папке."
                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />

                    <TextBlock Text="Название" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,18,0,6" />
                    <TextBox x:Name="InstanceNameBox" Style="{StaticResource InputBox}" MaxLength="40"
                             KeyDown="InstanceNameBox_KeyDown" />

                    <CheckBox x:Name="CopyModsCheck" Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0"
                              IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Скопировать моды и конфиги" FontSize="13" />
                            <TextBlock Text="Из активного инстанса. Миры не копируются."
                                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock x:Name="EditorError" Text="" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="EditorBusy" Text="" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,12,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="CloseEditor_Click" />
                        <Button x:Name="EditorConfirmButton" Style="{StaticResource PrimaryButton}" Content="Создать"
                                Click="EditorConfirm_Click" Margin="9,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- delete confirmation -->
        <Grid x:Name="ConfirmLayer" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}" Panel.ZIndex="60">
            <Border Style="{StaticResource Card}" Width="410" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Удалить инстанс?" FontSize="19" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock x:Name="DeleteText" Text="" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,9,0,0" />
                    <TextBlock Text="Папка инстанса, миры, моды и конфиги будут удалены без возможности отмены."
                               FontSize="10.5" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="DeleteError" Text="" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Оставить" Click="CloseDelete_Click" />
                        <Button x:Name="DeleteConfirmButton" Style="{StaticResource PrimaryButton}" Content="Удалить"
                                Click="DeleteConfirm_Click" Margin="9,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
