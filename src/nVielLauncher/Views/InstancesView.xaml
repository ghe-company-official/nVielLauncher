<UserControl x:Class="nVielLauncher.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <Grid>
        <!-- header -->
        <Grid Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Инстансы" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Отдельные сборки: свои моды, миры, конфиги и настройки"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="9"
                        Padding="12,7" Margin="0,0,10,0">
                    <TextBlock x:Name="CountText" Text="1 инстанс" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Click="Create_Click"
                        ToolTip="Создать новый инстанс">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Создать" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- active instance -->
                <Border x:Name="ActiveCard" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="14"
                                VerticalAlignment="Top">
                            <Path Data="{StaticResource IconInstance}" Width="21" Height="21" Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="АКТИВНЫЙ ИНСТАНС" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="ActiveName" Text="Основная" FontSize="21" FontWeight="SemiBold"
                                       FontFamily="{StaticResource DisplayFont}" Margin="0,5,0,0" />
                            <TextBlock x:Name="ActivePath" Text="—" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActiveStats" Text="—" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Click="OpenActiveFolder_Click"
                                    ToolTip="Открыть папку активного инстанса">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeLineJoin="Round" />
                                    <TextBlock Text="Папка" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="Rename_Click"
                                    ToolTip="Переименовать активный инстанс">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettings}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Переименовать" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteActiveButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Click="DeleteActive_Click" ToolTip="Удалить активный инстанс вместе с файлами">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeLineJoin="Round" />
                                    <TextBlock Text="Удалить" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="2,18,2,10">
                    <TextBlock Text="Все инстансы" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="ListHint" Text="Нажми «Выбрать», чтобы переключиться"
                               HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>

                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Height="12" Width="180" CornerRadius="4" Background="#12FFFFFF" HorizontalAlignment="Left" />
                            <Border Height="9" Width="310" CornerRadius="4" Background="#0BFFFFFF" Margin="0,10,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Height="12" Width="150" CornerRadius="4" Background="#12FFFFFF" HorizontalAlignment="Left" />
                            <Border Height="9" Width="260" CornerRadius="4" Background="#0BFFFFFF" Margin="0,10,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="InstanceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Background="{Binding CardBackground}"
                                    BorderBrush="{Binding CardBorder}" Padding="15,13" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource IconTile}" Width="38" Height="38" CornerRadius="11"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconInstance}" Width="16" Height="16" Stretch="Uniform"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#18FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1"
                                                    CornerRadius="5" Padding="6,2" Margin="8,0,0,0"
                                                    Visibility="{Binding ActiveBadgeVisibility}">
                                                <TextBlock Text="АКТИВЕН" FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                            <Border Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                                    CornerRadius="5" Padding="6,2" Margin="6,0,0,0"
                                                    Visibility="{Binding DefaultBadgeVisibility}">
                                                <TextBlock Text="ОСНОВНОЙ" FontSize="8.5"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Stats}" FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallGhostButton}" Content="Выбрать"
                                                Tag="{Binding Id}" Click="Activate_Click"
                                                Visibility="{Binding ActivateVisibility}" />
                                        <Button Style="{StaticResource SmallGhostButton}" Content="Удалить"
                                                Tag="{Binding Id}" Click="DeleteRow_Click"
                                                Visibility="{Binding DeleteVisibility}" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="26,28" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconInstance}" Width="30" Height="30" Stretch="Uniform"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.2"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Пока только основной инстанс" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Создай отдельную сборку, чтобы не смешивать моды и миры."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- in-page editor -->
        <Grid x:Name="EditorLayer" Visibility="Collapsed" Background="#CC050507" Panel.ZIndex="50">
            <Border Style="{StaticResource Card}" Width="430" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Text="Новый инстанс" FontSize="19" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock Text="Название видно только в лаунчере. Файлы останутся в отдельной папке."
                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />

                    <TextBlock Text="Название" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,18,0,6" />
                    <TextBox x:Name="InstanceNameBox" Style="{StaticResource InputBox}" MaxLength="40"
                             KeyDown="InstanceNameBox_KeyDown" />

                    <CheckBox x:Name="CopyModsCheck" Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0"
                              IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Скопировать моды и конфиги" FontSize="13" />
                            <TextBlock Text="Из активного инстанса. Миры не копируются."
                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock x:Name="EditorError" Text="" FontSize="10.5" Foreground="#FFFF9A9A"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="EditorBusy" Text="" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,12,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="CloseEditor_Click" />
                        <Button x:Name="EditorConfirmButton" Style="{StaticResource PrimaryButton}" Content="Создать"
                                Click="EditorConfirm_Click" Margin="9,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- delete confirmation -->
        <Grid x:Name="ConfirmLayer" Visibility="Collapsed" Background="#CC050507" Panel.ZIndex="60">
            <Border Style="{StaticResource Card}" Width="410" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Удалить инстанс?" FontSize="19" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock x:Name="DeleteText" Text="" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,9,0,0" />
                    <TextBlock Text="Папка инстанса, миры, моды и конфиги будут удалены без возможности отмены."
                               FontSize="10.5" Foreground="#FFFF9A9A" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="DeleteError" Text="" FontSize="10.5" Foreground="#FFFF9A9A"
                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Оставить" Click="CloseDelete_Click" />
                        <Button x:Name="DeleteConfirmButton" Style="{StaticResource PrimaryButton}" Content="Удалить"
                                Click="DeleteConfirm_Click" Margin="9,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
