<UserControl x:Class="nVielLauncher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Моды" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Файлы из папки mods устанавливаются в игру автоматически"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0BFFFFFF"
                    BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconMods}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="CountBadge" Text="0" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- stats -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4,2" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,11">
                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                        <Path Data="{StaticResource IconMods}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalModsText" Text="0" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="в папке mods" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource StrokeSoftBrush}" Margin="0,10" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,11">
                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                        <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="InstalledModsText" Text="0" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="уже в игре" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="3" Background="{StaticResource StrokeSoftBrush}" Margin="0,10" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="14,11">
                    <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                        <Path Data="{StaticResource IconBolt}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PendingModsText" Text="0" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="ждут установки" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ПАПКА С МОДАМИ" Style="{StaticResource Overline}" />
                    <TextBlock x:Name="SourcePathText" Text="—" FontSize="12" Margin="0,5,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallGhostButton}" Content="Открыть папку" Click="OpenSource_Click" />
                    <Button Style="{StaticResource SmallGhostButton}" Content="Папка игры" Margin="8,0,0,0" Click="OpenGame_Click" />
                    <Button Style="{StaticResource SmallGhostButton}" Content="Обновить" Margin="8,0,0,0" Click="Refresh_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="Название мода на Modrinth..."
                             KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" x:Name="ManagedButton" Style="{StaticResource SmallGhostButton}" Content="Установленные"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Managed_Click" />
                    <Button Grid.Column="2" Style="{StaticResource SmallGhostButton}" Content="Найти"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Search_Click" />
                    <Button Grid.Column="3" x:Name="BackButton" Style="{StaticResource SmallGhostButton}" Content="Мои моды"
                            Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="BackToLocal_Click" />
                </Grid>

                <TextBlock x:Name="SearchStatus" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="2,10,0,0" TextTrimming="CharacterEllipsis"
                           Text="Поиск и установка модов прямо с Modrinth — зависимости подтянутся автоматически" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,14,10,6">
            <Grid>
                <Grid x:Name="LocalPane">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModsList" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="10" Background="#FF101016"
                                                BorderBrush="#FF1E1E26" BorderThickness="1">
                                            <Path Data="{StaticResource IconMods}" Width="15" Height="15" Stretch="Uniform"
                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="8" Padding="9,4" VerticalAlignment="Center"
                                                Background="{Binding StateBackground}">
                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding StateForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="54" Height="54" CornerRadius="16" Background="#FF0B0B0F"
                            BorderBrush="#FF232330" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Модов пока нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Закинь .jar файлы в папку mods — они появятся здесь и установятся при запуске."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" MaxWidth="380"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                </Grid>

                <Grid x:Name="ResultsPane" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ResultsList" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Meta}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}"
                                                    Content="Установить" VerticalAlignment="Center" Click="InstallResult_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="ResultsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="Ничего не найдено" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Попробуй другой запрос." FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ManagedPane" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ManagedList" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" CornerRadius="6" Background="#14FFFFFF"
                                                            Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding BadgeVisibility}">
                                                        <TextBlock Text="ВЫКЛ" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Meta}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}"
                                                    Content="{Binding ToggleLabel}" VerticalAlignment="Center"
                                                    Click="ToggleManaged_Click" />
                                            <Button Grid.Column="2" Style="{StaticResource SmallGhostButton}" Content="Обновить"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" Click="UpdateManaged_Click" />
                                            <Button Grid.Column="3" Style="{StaticResource SmallGhostButton}" Content="Удалить"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" Click="RemoveManaged_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="ManagedEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="Установленных модов нет" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Найди мод на Modrinth — он появится здесь и его можно будет обновлять."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" MaxWidth="420"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Style="{StaticResource Caption}" Margin="4,12,0,0"
                   Text="Моды и их зависимости загружаются с Modrinth и ставятся в папку игры." />
    </Grid>
</UserControl>
