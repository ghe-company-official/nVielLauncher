<UserControl x:Class="nVielLauncher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <UserControl.Resources>
        <Storyboard x:Key="ModsAmbient">
            <DoubleAnimation Storyboard.TargetName="ModsOrbitA" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:44" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ModsOrbitB" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:29" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ModsCoreScale" Storyboard.TargetProperty="ScaleX"
                             From="0.9" To="1.08" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ModsCoreScale" Storyboard.TargetProperty="ScaleY"
                             From="0.9" To="1.08" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ModsGlow" Storyboard.TargetProperty="Opacity"
                             From="0.08" To="0.22" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ModsSparkA" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ModsSparkB" Storyboard.TargetProperty="Opacity"
                             From="0.1" To="0.85" Duration="0:0:2.3" BeginTime="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,6,2,16">
            <StackPanel>
                <TextBlock Text="Моды" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Собери игру под себя — моды, обновления и зависимости в одном месте."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlayFaintBrush}"
                    BorderBrush="{DynamicResource OverlayBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconMods}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="CountBadge" Text="0 модов" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- overview -->
        <Border x:Name="ModsHeroCard" Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" ClipToBounds="True">
            <Grid MinHeight="156">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="20,16,8,15" VerticalAlignment="Center">
                    <TextBlock Text="СБОРКА ПОД ТЕБЯ" Style="{StaticResource Overline}" />
                    <TextBlock Text="Твой Minecraft. Твои правила." FontFamily="{StaticResource DisplayFont}"
                               FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="Добавляй моды в папку или находи новые на Modrinth — зависимости подтянутся автоматически."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{DynamicResource OverlayFaintBrush}" CornerRadius="8" Padding="9,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconMods}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                <StackPanel Margin="7,0,0,0">
                                    <TextBlock x:Name="TotalModsText" Text="0" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="В СБОРКЕ" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource OverlayFaintBrush}" CornerRadius="8" Padding="9,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconCheck}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <StackPanel Margin="7,0,0,0">
                                    <TextBlock x:Name="InstalledModsText" Text="0" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="ГОТОВЫ" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource OverlayFaintBrush}" CornerRadius="8" Padding="9,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconBolt}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}" />
                                <StackPanel Margin="7,0,0,0">
                                    <TextBlock x:Name="PendingModsText" Text="0" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="К УСТАНОВКЕ" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Width="176" Height="148" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="104" Height="104" Fill="{DynamicResource AccentBrush}" Opacity="0.12">
                        <Ellipse.Effect><BlurEffect Radius="26" /></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="136" Height="136" Stroke="{DynamicResource BorderSubtleBrush}"
                             StrokeThickness="1" StrokeDashArray="1 5" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="ModsOrbitA" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="102" Height="102" Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="1.3" StrokeDashArray="14 12" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="ModsOrbitB" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="ModsGlow" Width="74" Height="74" Fill="{DynamicResource AccentBrush}"
                             Opacity="0.14" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Effect><BlurEffect Radius="16" /></Ellipse.Effect>
                        <Ellipse.RenderTransform><ScaleTransform x:Name="ModsCoreScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="52" Height="52" CornerRadius="17" Background="{DynamicResource BgSoftBrush}"
                            BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1">
                        <Path Data="{DynamicResource IconMods}" Width="25" Height="25" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Path x:Name="ModsSparkA" Data="{DynamicResource IconPlus}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,15,0" />
                    <Ellipse x:Name="ModsSparkB" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,20" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" />
                        <TextBlock Text=" ПАПКА С МОДАМИ" Style="{StaticResource Overline}" />
                    </StackPanel>
                    <TextBlock x:Name="SourcePathText" Text="—" FontSize="12" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallGhostButton}" Click="OpenSource_Click" ToolTip="Открыть папку с модами">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconFolder}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Папка модов" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallGhostButton}" Margin="8,0,0,0" Click="OpenGame_Click" ToolTip="Открыть папку игры">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconHome}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Папка игры" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallGhostButton}" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Обновить список модов">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconRefresh}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Обновить" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="Название мода на Modrinth..."
                             KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" x:Name="ManagedButton" Style="{StaticResource SmallGhostButton}"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Managed_Click" ToolTip="Установленные моды">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconInstance}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Установленные" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="DependenciesButton" Style="{StaticResource SmallGhostButton}"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="CheckDependencies_Click" ToolTip="Проверить зависимости">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconLink}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Зависимости" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" x:Name="ConflictsButton" Style="{StaticResource SmallGhostButton}"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Conflicts_Click"
                            ToolTip="Дубликаты, несовместимости и нехватка зависимостей">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconWarning}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Конфликты" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource SmallGhostButton}" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconSearch}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                            <TextBlock Text="Найти" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" x:Name="BackButton" Style="{StaticResource SmallGhostButton}" Margin="8,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="BackToLocal_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconMods}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Мои моды" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Name="SearchStatus" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="2,10,0,0" TextTrimming="CharacterEllipsis"
                           Text="Поиск и установка модов прямо с Modrinth — зависимости подтянутся автоматически" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,14,10,6">
            <Grid>
                <Grid x:Name="LocalPane">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModsList" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceHoverBrush}"
                                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                                            <Path Data="{DynamicResource IconMods}" Width="15" Height="15" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="8" Padding="9,4" VerticalAlignment="Center"
                                                Background="{Binding StateBackground}">
                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding StateForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource BgSoftBrush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{DynamicResource IconPlus}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Модов пока нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Закинь .jar файлы в папку mods — они появятся здесь и установятся при запуске."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" MaxWidth="380"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                </Grid>

                <Grid x:Name="ResultsPane" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ResultsList" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Meta}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}"
                                                    Content="Установить" VerticalAlignment="Center" Click="InstallResult_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="ResultsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="Ничего не найдено" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Попробуй другой запрос." FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ManagedPane" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ManagedList" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource OverlayBrush}"
                                                            Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding BadgeVisibility}">
                                                        <TextBlock Text="ВЫКЛ" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Meta}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}"
                                                    Content="{Binding ToggleLabel}" VerticalAlignment="Center"
                                                    Click="ToggleManaged_Click" />
                                            <Button Grid.Column="2" Style="{StaticResource SmallGhostButton}" Content="Обновить"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" Click="UpdateManaged_Click" />
                                            <Button Grid.Column="3" Style="{StaticResource SmallGhostButton}" Content="Удалить"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" Click="RemoveManaged_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="ManagedEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="Установленных модов нет" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Найди мод на Modrinth — он появится здесь и его можно будет обновлять."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" MaxWidth="420"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Style="{StaticResource Caption}" Margin="4,12,0,0"
                   Text="Моды и их зависимости загружаются с Modrinth и ставятся в папку игры." />
    </Grid>
</UserControl>
