<UserControl x:Class="nVielLauncher.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <UserControl.Resources>
        <Storyboard x:Key="ModpacksAmbient">
            <DoubleAnimation Storyboard.TargetName="PacksOrbitA" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:46" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="PacksOrbitB" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:32" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="PacksCoreScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.07" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="PacksCoreScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.07" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="PacksGlow" Storyboard.TargetProperty="Opacity"
                             From="0.08" To="0.22" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="PacksSpark" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1" Duration="0:0:1.9" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Сборки" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Готовые сборки Modrinth (.mrpack) или импорт из файла"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlayFaintBrush}"
                    BorderBrush="{DynamicResource OverlayBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconPack}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountBadge" Text="0 сборок" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- search + import -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconSparkles}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" />
                    <TextBlock Text=" НАЙДИ СВОЮ СБОРКУ" Style="{StaticResource Overline}" Margin="7,0,0,0" />
                </StackPanel>
                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}"
                             Tag="Поиск сборок на Modrinth..." KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconSearch}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                            <TextBlock Text="Найти" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="ImportButton" Style="{StaticResource SmallGhostButton}"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Import_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconPack}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            <TextBlock Text="Импорт .mrpack" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="2,10,0,0" TextTrimming="CharacterEllipsis"
                           Text="Сборка установится в папку игры: моды, конфиги и ресурсы — автоматически" />

                <ProgressBar x:Name="InstallProgress" Style="{StaticResource SlimProgress}" Height="4"
                             Margin="2,10,2,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- results -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,14,10,6" Margin="0,0,0,12">
            <Grid>
                <Border x:Name="PackHeroCard" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0"
                        Width="160" Height="142" IsHitTestVisible="False" ClipToBounds="False">
                    <Grid>
                        <Ellipse Width="92" Height="92" Fill="{DynamicResource AccentBrush}" Opacity="0.12">
                            <Ellipse.Effect><BlurEffect Radius="22" /></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="126" Height="126" Stroke="{DynamicResource BorderSubtleBrush}"
                                 StrokeThickness="1" StrokeDashArray="1 5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="PacksOrbitA" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="96" Height="96" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                 StrokeDashArray="14 12" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="PacksOrbitB" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="PacksGlow" Width="68" Height="68" Fill="{DynamicResource AccentBrush}"
                                 Opacity="0.14" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Effect><BlurEffect Radius="15" /></Ellipse.Effect>
                            <Ellipse.RenderTransform><ScaleTransform x:Name="PacksCoreScale" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Width="50" Height="50" CornerRadius="16" Background="{DynamicResource BgSoftBrush}"
                                BorderBrush="{DynamicResource OverlayStrongBrush}" BorderThickness="1">
                            <Path Data="{DynamicResource IconPack}" Width="24" Height="24" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Path x:Name="PacksSpark" Data="{DynamicResource IconSparkles}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,13,0" />
                    </Grid>
                </Border>
                <Grid x:Name="ResultsContent" Margin="0,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ResultsList" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Meta}" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}" Content="Установить"
                                                VerticalAlignment="Center" Click="InstallResult_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="ResultsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource BgSoftBrush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{DynamicResource IconPack}" Width="22" Height="22" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Найди сборку или импортируй .mrpack" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Мы скачаем все моды сборки с Modrinth и распакуем настройки прямо в папку игры."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" MaxWidth="400"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- installed -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <TextBlock Text="УСТАНОВЛЕННЫЕ СБОРКИ" Style="{StaticResource Overline}" />

                <TextBlock x:Name="InstalledEmpty" Text="Пока пусто." FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,2" />

                <ItemsControl x:Name="InstalledList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                                    <Path Data="{DynamicResource IconCheck}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Margin="4,12,0,0"
                   Text="Поддерживаются сборки Modrinth формата .mrpack — моды, конфиги и ресурспаки." />
    </Grid>
</UserControl>
