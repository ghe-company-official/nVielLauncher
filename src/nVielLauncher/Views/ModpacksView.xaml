<UserControl x:Class="nVielLauncher.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="2,6,2,18">
            <StackPanel>
                <TextBlock Text="Сборки" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SubHeader" Text="Готовые сборки Modrinth (.mrpack) или импорт из файла"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0BFFFFFF"
                    BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPack}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountBadge" Text="0" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- search + import -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}"
                             Tag="Поиск сборок на Modrinth..." KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}" Content="Найти"
                            Margin="8,0,0,0" VerticalAlignment="Center" Click="Search_Click" />
                    <Button Grid.Column="2" x:Name="ImportButton" Style="{StaticResource SmallGhostButton}"
                            Content="Импорт .mrpack" Margin="8,0,0,0" VerticalAlignment="Center" Click="Import_Click" />
                </Grid>

                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="2,10,0,0" TextTrimming="CharacterEllipsis"
                           Text="Сборка установится в папку игры: моды, конфиги и ресурсы — автоматически" />

                <ProgressBar x:Name="InstallProgress" Style="{StaticResource SlimProgress}" Height="4"
                             Margin="2,10,2,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- results -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,14,10,6" Margin="0,0,0,12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ResultsList" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Meta}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource SmallGhostButton}" Content="Установить"
                                                VerticalAlignment="Center" Click="InstallResult_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="ResultsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16" Background="#FF0B0B0F"
                            BorderBrush="#FF232330" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconPack}" Width="22" Height="22" Stretch="Uniform"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Найди сборку или импортируй .mrpack" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Мы скачаем все моды сборки с Modrinth и распакуем настройки прямо в папку игры."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" MaxWidth="400"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- installed -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <TextBlock Text="УСТАНОВЛЕННЫЕ СБОРКИ" Style="{StaticResource Overline}" />

                <TextBlock x:Name="InstalledEmpty" Text="Пока пусто." FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,2" />

                <ItemsControl x:Name="InstalledList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9" Background="#FF101016"
                                        BorderBrush="#FF1E1E26" BorderThickness="1">
                                    <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Margin="4,12,0,0"
                   Text="Поддерживаются сборки Modrinth формата .mrpack — моды, конфиги и ресурспаки." />
    </Grid>
</UserControl>
