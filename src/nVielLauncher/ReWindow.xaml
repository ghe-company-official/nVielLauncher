<Window x:Class="nVielLauncher.ReWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="nVielRE"
        Width="1180" Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource TextFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ReBlob1Transform" Storyboard.TargetProperty="X"
                                     From="-60" To="90" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ReBlob1Transform" Storyboard.TargetProperty="Y"
                                     From="-20" To="60" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ReBlob2Transform" Storyboard.TargetProperty="X"
                                     From="50" To="-80" Duration="0:0:30" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ReBlob2Transform" Storyboard.TargetProperty="Y"
                                     From="10" To="-60" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ScanTransform" Storyboard.TargetProperty="Y"
                                     From="-190" To="790" Duration="0:0:6.5" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" BorderBrush="#1CFFFFFF" BorderThickness="1"
            CornerRadius="16" ClipToBounds="True">
        <Grid x:Name="RootGrid">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RenderTransformOrigin>
                <Point X="0.5" Y="0.5" />
            </Grid.RenderTransformOrigin>

            <!-- ================= backdrop ================= -->
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Fill="{StaticResource BgBrush}" />

                <Ellipse Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-320,-400,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#18FFFFFF" Offset="0" />
                            <GradientStop Color="#08FFFFFF" Offset="0.45" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="ReBlob1Transform" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-380">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#12FFFFFF" Offset="0" />
                            <GradientStop Color="#05FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="ReBlob2Transform" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Rectangle Opacity="0.6">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,46,46" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Geometry="M0,0 H46 M0,0 V46">
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#0BFFFFFF" Thickness="1" />
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <TextBlock Text="RE" FontFamily="{StaticResource DisplayFont}" FontSize="540" FontWeight="Bold"
                           Foreground="#05FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,40,-30,0" />

                <Rectangle Height="190" VerticalAlignment="Top" Opacity="0.06">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ScanTransform" Y="-190" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#66060608" Offset="0.8" />
                            <GradientStop Color="#DD060608" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- ================= chrome ================= -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Grid Width="18" Height="18">
                            <Ellipse Fill="#0DFFFFFF" Stroke="#3AFFFFFF" StrokeThickness="1" />
                            <Path Data="{StaticResource IconRefresh}" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="nViel" FontFamily="{StaticResource DisplayFont}" FontSize="13.5" FontWeight="Bold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Border Background="#18FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="6"
                                Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RE" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <Border Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6"
                                Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RECOVERY MODE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Background="#0BFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8"
                                Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderDot" Width="5" Height="5" Fill="#FF7BE3A0" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeaderStatus" Text="SYSTEM READY" FontSize="9" FontWeight="SemiBold"
                                           Margin="7,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Свернуть">
                            <Path Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="Close_Click" Margin="4,0,0,0" ToolTip="Закрыть">
                            <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="22,0,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ================= left: identity + status ================= -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="nViel" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="RE" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                               FontWeight="Light" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="7,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Border Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                            CornerRadius="6" Padding="7,3">
                                        <TextBlock Text="RECOVERY EDITION" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Background="#0BFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                            CornerRadius="6" Padding="7,3" Margin="6,0,0,0">
                                        <TextBlock Text="2.0" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Сервисный режим лаунчера. Полная проверка Java, файлов Minecraft, Fabric и модов — без запуска игры."
                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" LineHeight="17" Margin="0,14,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Height="1" Background="{StaticResource StrokeSoftBrush}" Margin="0,16,0,4" />

                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ" Style="{StaticResource Overline}" Margin="2,0,0,10" />

                                <Border Style="{StaticResource InsetCard}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="JavaDot" Width="7" Height="7" Fill="#FF565660" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="Java 21" FontSize="12.5" FontWeight="Medium" />
                                            <TextBlock x:Name="JavaDetail" Text="проверка..." FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Name="JavaBadge" Grid.Column="2" Text="—" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource InsetCard}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="GameDot" Width="7" Height="7" Fill="#FF565660" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="Minecraft 1.21.4" FontSize="12.5" FontWeight="Medium" />
                                            <TextBlock x:Name="GameDetail" Text="проверка..." FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Name="GameBadge" Grid.Column="2" Text="—" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource InsetCard}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="ModsDot" Width="7" Height="7" Fill="#FF565660" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="Моды" FontSize="12.5" FontWeight="Medium" />
                                            <TextBlock x:Name="ModsDetail" Text="проверка..." FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Name="ModsBadge" Grid.Column="2" Text="—" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource InsetCard}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="LauncherDot" Width="7" Height="7" Fill="#FF7BE3A0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock Text="Лаунчер" FontSize="12.5" FontWeight="Medium" />
                                            <TextBlock x:Name="LauncherDetail" Text="настройки" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Name="LauncherBadge" Grid.Column="2" Text="OK" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource InsetCard}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="СИСТЕМА" Style="{StaticResource Overline}" />
                                        <TextBlock x:Name="SystemDetail" Text="собираем данные..." FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                <Button x:Name="BackToLauncherButton" Style="{StaticResource GhostButton}"
                                        Content="← Вернуться в лаунчер" Click="BackToLauncher_Click" />
                                <TextBlock x:Name="BuildText" Style="{StaticResource Caption}" Margin="2,10,0,0"
                                           Text="nVielRE 2.0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ================= right: repair + console ================= -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="SYSTEM REPAIR" Style="{StaticResource Overline}" />
                                    <TextBlock Text="Полное восстановление" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock x:Name="RepairSubtitle"
                                               Text="Java, клиент, библиотеки, ресурсы, Fabric и обязательные моды."
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />

                                    <ProgressBar x:Name="RepairProgress" Style="{StaticResource SlimProgress}"
                                                 Value="0" Margin="0,18,0,0" />
                                    <Grid Margin="0,9,0,0">
                                        <TextBlock x:Name="RepairStatus" Text="Готов к проверке" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="RepairPercent" Text="0%" HorizontalAlignment="Right"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Button x:Name="RepairButton" Style="{StaticResource PrimaryButton}" Content="REPAIR"
                                            Padding="34,18" FontSize="15" MinWidth="190" Click="Repair_Click" />
                                    <Button x:Name="StopButton" Style="{StaticResource LinkButton}" Content="Остановить"
                                            Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,10,0,0"
                                            Click="Stop_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="18,13,18,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ConsoleDot" Width="6" Height="6" Fill="#FF7BE3A0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="SYSTEM CONSOLE" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource LinkButton}" Content="Отчёт" Margin="0,0,12,0"
                                                Click="BuildReport_Click" />
                                        <Button Style="{StaticResource LinkButton}" Content="Очистить" Margin="0,0,12,0"
                                                Click="ClearConsole_Click" />
                                        <Button Style="{StaticResource LinkButton}" Content="Скопировать"
                                                Click="CopyConsole_Click" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#FF050508" BorderBrush="{StaticResource StrokeSoftBrush}"
                                        BorderThickness="0,1,0,1">
                                    <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Padding="18,12">
                                        <StackPanel x:Name="ConsolePanel" />
                                    </ScrollViewer>
                                </Border>

                                <Grid Grid.Row="2" Margin="14,12,14,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button Style="{StaticResource ActionTile}" Margin="0,0,5,5" Click="QuickJava_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="8">
                                                <Path Data="{StaticResource IconJava}" Width="13" Height="13" Stretch="Uniform"
                                                      Fill="{StaticResource TextSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Java" FontSize="11.5" FontWeight="Medium" />
                                                <TextBlock Text="проверить и скачать" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Style="{StaticResource ActionTile}" Margin="5,0,5,5" Click="QuickMods_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="8">
                                                <Path Data="{StaticResource IconMods}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Моды" FontSize="11.5" FontWeight="Medium" />
                                                <TextBlock Text="восстановить core" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource ActionTile}" Margin="5,0,0,5" Click="QuickFabric_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="8">
                                                <Path Data="{StaticResource IconPack}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Fabric" FontSize="11.5" FontWeight="Medium" />
                                                <TextBlock Text="файлы игры" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="1" Style="{StaticResource ActionTile}" Margin="0,5,5,0" Click="OpenCrash_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="8">
                                                <Path Data="{StaticResource IconShield}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Крэши" FontSize="11.5" FontWeight="Medium" />
                                                <TextBlock Text="crash-reports" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionTile}" Margin="5,5,5,0" Click="OpenLogs_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="8">
                                                <Path Data="{StaticResource IconLogs}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Логи" FontSize="11.5" FontWeight="Medium" />
                                                <TextBlock Text="журналы игры" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionTile}" Margin="5,5,0,0" Click="OpenGame_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconTile}" Width="28" Height="28" CornerRadius="8">
                                                <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Папка игры" FontSize="11.5" FontWeight="Medium" />
                                                <TextBlock Text="открыть" FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
