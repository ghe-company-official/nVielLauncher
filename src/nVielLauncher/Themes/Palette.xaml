<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Base palette. These values are the nViel monochrome defaults and are kept as a
        fallback for design-time. At runtime MaterialTheme.Apply() replaces every colour
        and brush below, so screens only ever read the tokens through DynamicResource.
    -->
    <Color x:Key="BgColor">#FF060608</Color>
    <Color x:Key="BgSoftColor">#FF09090C</Color>
    <Color x:Key="SurfaceColor">#FF0C0C10</Color>
    <Color x:Key="SurfaceHoverColor">#FF131318</Color>
    <Color x:Key="StrokeColor">#FF1B1B21</Color>
    <Color x:Key="StrokeSoftColor">#FF121217</Color>
    <Color x:Key="StrokeStrongColor">#FF2B2B33</Color>
    <Color x:Key="TextPrimaryColor">#FFF5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#FF9B9BA6</Color>
    <Color x:Key="TextMutedColor">#FF61616C</Color>
    <Color x:Key="AccentColor">#FFFFFFFF</Color>
    <Color x:Key="OnAccentColor">#FF070709</Color>
    <Color x:Key="BlackColor">#FF050507</Color>
    <Color x:Key="SuccessColor">#FF7BE3A0</Color>
    <Color x:Key="DangerColor">#FFFF9A9A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgSoftBrush" Color="{StaticResource BgSoftColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- Translucent layers. They follow the text colour so a tinted theme stays readable. -->
    <SolidColorBrush x:Key="OverlayFaintBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="OverlaySoftBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="OverlayStrongBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC050507" />
    <SolidColorBrush x:Key="ScrimSoftBrush" Color="#55060608" />
    <SolidColorBrush x:Key="HoverFillBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ActiveFillBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <CubicEase x:Key="OutEase" EasingMode="EaseOut" />
    <CubicEase x:Key="InOutEase" EasingMode="EaseInOut" />

</ResourceDictionary>
