<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- nViel monochrome palette -->
    <Color x:Key="BgColor">#FF060608</Color>
    <Color x:Key="BgSoftColor">#FF09090C</Color>
    <Color x:Key="SurfaceColor">#FF0C0C10</Color>
    <Color x:Key="SurfaceHoverColor">#FF131318</Color>
    <Color x:Key="StrokeColor">#FF1B1B21</Color>
    <Color x:Key="StrokeSoftColor">#FF121217</Color>
    <Color x:Key="StrokeStrongColor">#FF2B2B33</Color>
    <Color x:Key="TextPrimaryColor">#FFF5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#FF9B9BA6</Color>
    <Color x:Key="TextMutedColor">#FF61616C</Color>
    <Color x:Key="AccentColor">#FFFFFFFF</Color>
    <Color x:Key="BlackColor">#FF050507</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgSoftBrush" Color="{StaticResource BgSoftColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />

    <SolidColorBrush x:Key="HoverFillBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ActiveFillBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <CubicEase x:Key="OutEase" EasingMode="EaseOut" />
    <CubicEase x:Key="InOutEase" EasingMode="EaseInOut" />

</ResourceDictionary>
